# Local development against the rmu-platform stack. Copy to .env and run `make start`.
# webpack loads `.env.<mode>` first (for example `.env.development`) and falls back to `.env`.
#
# The RMU_* values are not baked into the bundle: the dev server serves them as /env-config.js
# (keys listed in public/env-config.template.js). They only apply when core is opened standalone
# on http://localhost:8089; inside the shell (http://localhost through the rmu-platform gateway)
# the shell's configuration is used.
PORT=8089
# Images and locales served by rmu-mfe-assets (`python3 local-start.py`).
RMU_MFE_ASSETS=http://localhost:4000/
# APIs. Standalone on :8089 there is no gateway, so use the API ports directly.
RMU_API_CORE_URL=http://localhost:3001/v1
RMU_API_STRATEGIC_URL=http://localhost:3002/v1
RMU_API_TACTICAL_URL=http://localhost:3003/v1
RMU_API_ATTACK_TABLES_URL=http://localhost:3005/v1
RMU_API_ITEMS_URL=http://localhost:3006/v1
RMU_API_NPCS_URL=http://localhost:3008/v1
RMU_API_SPELLS_URL=http://localhost:3009/v1
RMU_API_MEDIA_URL=http://localhost:3011/v1
