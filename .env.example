# Local development against the rmu-platform stack. Copy to .env and run `make start`.
# webpack loads `.env.<mode>` first (for example `.env.development`) and falls back to `.env`.
PORT=8089
RMU_MFE_SHELL_PUBLIC_PATH=http://localhost:8080/
RMU_MFE_CORE_PUBLIC_PATH=http://localhost:8089/
# Images and locales served by rmu-mfe-assets (`python3 local-start.py`).
RMU_MFE_ASSETS=http://localhost:4000/
# rmu-api-core (rmu-platform `apis` profile or `npm run start:dev` in rmu-api-core).
RMU_API_CORE_URL=http://localhost:3001/v1
