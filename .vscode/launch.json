{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug core in the shell (gateway)",
      "detail": "Stop the container first: `make mfe-dev s=core` in rmu-platform",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost/core",
      "webRoot": "${workspaceFolder}",
      "preLaunchTask": "start:live",
      "sourceMapPathOverrides": {
        "webpack://core/./*": "${workspaceFolder}/*"
      }
    },
    {
      "name": "Debug core standalone (:8089)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:8089",
      "webRoot": "${workspaceFolder}",
      "preLaunchTask": "start:live",
      "sourceMapPathOverrides": {
        "webpack://core/./*": "${workspaceFolder}/*"
      }
    }
  ]
}
